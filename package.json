{
  "name": "brainrot-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:associations-layouts": "tsx scripts/build-associations-layouts.ts",
    "check:associations-layouts": "tsx scripts/build-associations-layouts.ts --check",
    "build:cube-lines": "tsx scripts/build-cube-lines-layouts.ts",
    "check:cube-lines": "tsx scripts/build-cube-lines-layouts.ts --check",
    "build:cube-lines-catalog": "tsx scripts/build-cube-lines-catalog.ts",
    "test:cube-lines": "tsx --test src/games/cube-lines/*.test.ts",
    "preview": "vite preview",
    "test:gate-runner": "node --import tsx --test src/games/gate-runner/*.test.ts",
    "simulate:gate-runner": "node --import tsx scripts/simulate-gate-runner.ts",
    "test:breakout": "node --import tsx --test src/games/breakout/*.test.ts",
    "simulate:breakout": "node --import tsx scripts/simulate-breakout.ts",
    "test:fieldwork": "node --import tsx --test src/games/fieldwork/*.test.ts",
    "simulate:fieldwork": "node --import tsx scripts/simulate-fieldwork.ts"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  }
}
